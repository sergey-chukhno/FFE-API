# Configuration Base de Données PostgreSQL
# En local avec Docker (port 5433) :
DATABASE_URL="postgres://recupffe:recupffe_password@localhost:5433/recupffe"

# En production sur Vercel (Neon Serverless) :
# DATABASE_URL="postgres://default:xxx@ep-xxx-pooler.eu-central-1.aws.neon.tech/verceldb?sslmode=require"

# Secret pour sécuriser le point d'accès du Cron 24h
CRON_SECRET="change-this-to-a-secure-random-token"

# Code FFE du club Marseille-Échecs
DEFAULT_CLUB_CODE="N06013"
DEFAULT_CLUB_NAME="Marseille-Echecs"
